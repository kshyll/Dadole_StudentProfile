{
  "name": "com.dadole.studentprofile",
  "displayName": "Student-Profile",
  "version": "1.0.0",
  "description": "Cordova Student Profile with Supabase authentication, database, CRUD, and camera integration.",
  "scripts": {
    "postinstall": "node scripts/setup-supabase.js",
    "setup": "node scripts/setup-supabase.js"
  },
  "keywords": [
    "ecosystem:cordova",
    "student-profile",
    "supabase"
  ],
  "author": "Trishya Dadole",
  "license": "Apache-2.0",
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0"
  },
  "devDependencies": {
    "cordova-android": "^15.1.0",
    "cordova-plugin-camera": "^8.0.0",
    "cordova-plugin-file": "^8.1.3"
  },
  "cordova": {
    "platforms": [
      "android"
    ],
    "plugins": {
      "cordova-plugin-camera": {
        "ANDROIDX_CORE_VERSION": "1.6.+"
      },
      "cordova-plugin-file": {
        "ANDROIDX_WEBKIT_VERSION": "1.4.0"
      }
    }
  }
}
